// Prisma Generator
generator client {
  provider = "prisma-client-js"
}

// Database Configuration
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  avatar    String?
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One-to-many relationship with Property (An agent can have many properties)
  properties Property[] @relation("AgentProperties")
}

model Property {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  price        Float
  type         PropertyType
  status       PropertyStatus
  bedrooms     Int?
  bathrooms    Int?
  area         Float?
  address      String
  city         String
  latitude     Float?
  longitude    Float?
  features     String[]
  images       String[]
  agentId      String       @db.ObjectId
  agent        User         @relation("AgentProperties", fields: [agentId], references: [id])  // Establish the relation
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
}

enum PropertyStatus {
  FOR_SALE
  FOR_RENT
}

enum UserRole {
  AGENT
  CLIENT
}
